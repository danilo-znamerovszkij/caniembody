{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glossary.schema.json",
  "type": "object",
  "required": ["id", "term", "short", "body", "sources"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "term": { "type": "string" },
    "aka": { "type": "array", "items": { "type": "string" } },
    "short": { "type": "string", "maxLength": 200, "description": "One-sentence definition (meta description)" },
    "body": { "type": "string", "description": "Markdown, 150-300 words. Link matrix pages as /policy/<id>, /robot/<id>, /glossary/<id>." },
    "related": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
    "policies": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "description": "Policies this term is relevant to" },
    "sources": { "$ref": "common.schema.json#/$defs/sources", "minItems": 1 }
  },
  "additionalProperties": false
}
