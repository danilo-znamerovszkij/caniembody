---
// 2×2 matrix, one resolved cell. Square-ish corners, equal gaps, optically balanced 1.5px strokes.
// Renders crisply at 16/24/32px; `mono` drops the cobalt for single-colour contexts.
const { size = 20, mono = false } = Astro.props as { size?: number; mono?: boolean };
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <rect x="2.75" y="2.75" width="7.5" height="7.5" rx="1.25" fill="none" stroke="currentColor" stroke-width="1.5" />
  <rect x="13.75" y="2.75" width="7.5" height="7.5" rx="1.25" fill="none" stroke="currentColor" stroke-width="1.5" />
  <rect x="2.75" y="13.75" width="7.5" height="7.5" rx="1.25" fill="none" stroke="currentColor" stroke-width="1.5" />
  <rect x="13" y="13" width="9" height="9" rx="1.5" fill={mono ? 'currentColor' : 'var(--accent)'} />
</svg>
